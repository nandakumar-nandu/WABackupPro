# WABackupPro Environment Settings

# Google Drive API Keys
# You can obtain this key from the Google Cloud Console (https://console.cloud.google.com/)
# 1. Create a project
# 2. Enable Google Drive API
# 3. Create OAuth 2.0 Client ID for Android
GOOGLE_DRIVE_API_KEY=YOUR_API_KEY_HERE

# Note: Since this is an Android app using Google Sign-In, the OAuth client ID is generally 
# matched via the package name and SHA-1 signing certificate footprint rather than an API key. 
# However, if your backend server requires it, place the Web Client ID here:
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID_HERE
